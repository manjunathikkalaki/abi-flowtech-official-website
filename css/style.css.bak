:root {
    --navy: #0b1f3a;
    --steel: #1b3a5c;
    --accent: #e05b14;
    --gold: #c8992a;
    --light: #f4f6f9;
    --white: #ffffff;
    --gray: #6b7a8d;
    --border: #d0dae6;
}

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; }
body { font-family: 'Barlow', sans-serif; background: var(--light); color: var(--navy); overflow-x: hidden; }

  /* NAV */
  nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 100;
    background: var(--navy);
    display: flex; align-items: center; justify-content: space-between;
    padding: 0 4%; height: 68px;
    box-shadow: 0 2px 20px rgba(0,0,0,.4);
  }

.nav-logo { display: flex; align-items: center; gap: 12px; text-decoration: none; }
.nav-logo svg { height: 48px; width: auto; }

.nav-logo-text {
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 800; font-size: 1.25rem; letter-spacing: 1px; color: #fff; line-height: 1.1;
}

.nav-logo-text span { color: var(--accent); }
.nav-logo-sub { font-size: .65rem; color: #7398ba; letter-spacing: 1.5px; text-transform: uppercase; }
.nav-links { display: flex; gap: 1.8rem; list-style: none; }
.nav-links a { color: #b0c4de; text-decoration: none; font-size: .82rem; font-weight: 500; letter-spacing: .5px; text-transform: uppercase; transition: color .2s; }
.nav-links a:hover { color: var(--accent); }

/* HERO */
#home {
    height: 100vh; min-height: 640px;
    background: linear-gradient(135deg, var(--navy) 0%, var(--steel) 55%, #24547a 100%);
    display: flex; flex-direction: column; justify-content: center; align-items: flex-start;
    padding: 120px 8% 80px; position: relative; overflow: hidden;
}

#home::before {
    content: ''; position: absolute; inset: 0;
    background: url("data:image/svg+xml,%3Csvg width='80' height='80' viewBox='0 0 80 80' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none'%3E%3Cg fill='%23ffffff' fill-opacity='0.03'%3E%3Cpath d='M50 50c0-5.523 4.477-10 10-10s10 4.477 10 10-4.477 10-10 10c0 5.523-4.477 10-10 10s-10-4.477-10-10 4.477-10 10-10zM10 10c0-5.523 4.477-10 10-10s10 4.477 10 10-4.477 10-10 10c0 5.523-4.477 10-10 10S0 25.523 0 20s4.477-10 10-10z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E") repeat;
}

.hero-tag {
    background: var(--accent); color: #fff;
    font-family: 'Barlow Condensed', sans-serif; font-size: .75rem; font-weight: 700; letter-spacing: 2px;
    text-transform: uppercase; padding: 4px 14px; border-radius: 2px; margin-bottom: 1.2rem; display: inline-block;
}

.hero-title {
    font-family: 'Barlow Condensed', sans-serif; font-size: clamp(3rem, 7vw, 5.5rem);
    font-weight: 800; color: var(--white); line-height: 1.0; margin-bottom: 1rem;
    text-transform: uppercase; letter-spacing: 2px;
}

.hero-title em { color: var(--accent); font-style: normal; }
.hero-sub { font-size: clamp(.95rem,1.5vw,1.15rem); color: #b0c4de; max-width: 560px; line-height: 1.7; margin-bottom: 2.2rem; }
.hero-btns { display: flex; gap: 1rem; flex-wrap: wrap; }
.btn-primary {
    background: var(--accent); color: #fff; padding: 14px 36px; border-radius: 3px;
    font-weight: 700; font-size: 1rem; letter-spacing: .5px; text-decoration: none;
    border: none; cursor: pointer; transition: background .2s, transform .15s; display: inline-block;
}

.btn-primary:hover { background: #c04e10; transform: translateY(-2px); }
.btn-outline {
    border: 2px solid #b0c4de; color: #b0c4de; padding: 12px 34px; border-radius: 3px;
    font-weight: 700; font-size: 1rem; text-decoration: none; transition: all .2s; display: inline-block; cursor: pointer;
}

.btn-outline:hover { border-color: var(--white); color: var(--white); background: rgba(255,255,255,.05); }
.hero-stats { position: absolute; right: 8%; bottom: 60px; display: flex; gap: 3rem; }
.stat { text-align: center; }
.stat-num { font-family: 'Barlow Condensed', sans-serif; font-size: 2.8rem; font-weight: 800; color: var(--accent); line-height: 1; }
.stat-label { font-size: .75rem; color: #7898b5; text-transform: uppercase; letter-spacing: 1px; margin-top: 4px; }
.scroll-line { position: absolute; left: 8%; bottom: 0; width: 2px; height: 80px; background: linear-gradient(to bottom, transparent, var(--accent)); }

/* SECTION BASE */
section { padding: 90px 8%; }
.section-tag {
    display: inline-block; background: rgba(224,91,20,.12); color: var(--accent);
    font-family: 'Barlow Condensed', sans-serif; font-size: .72rem; font-weight: 700; letter-spacing: 2px;
    text-transform: uppercase; padding: 4px 12px; border-radius: 2px; margin-bottom: .8rem;
}

.section-title {
    font-family: 'Barlow Condensed', sans-serif; font-size: clamp(1.8rem,3.5vw,2.8rem);
    font-weight: 800; color: var(--navy); text-transform: uppercase; letter-spacing: 1px;
    margin-bottom: .5rem; line-height: 1.1;
}
.section-title em { color: var(--accent); font-style: normal; }
.section-desc { font-size: 1rem; color: var(--gray); max-width: 640px; line-height: 1.75; margin-bottom: 3rem; }

/* ABOUT */
#about { background: var(--white); }
    .about-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 5rem; align-items: center; }
    .about-visual { position: relative; background: linear-gradient(135deg, var(--navy), var(--steel)); border-radius: 4px; padding: 3rem 2rem; color: #fff; overflow: hidden; }
    .about-visual::after { content: '⚙'; position: absolute; right: -20px; bottom: -20px; font-size: 120px; opacity: .05; line-height: 1; }
    .about-visual h3 { font-family: 'Barlow Condensed', sans-serif; font-size: 1.8rem; font-weight: 700; margin-bottom: 1rem; }
    .about-visual p { color: #a0b8d0; line-height: 1.7; font-size: .95rem; }
    .gstin-badge { display: inline-block; margin-top: 1.5rem; background: rgba(200,153,42,.15); border: 1px solid var(--gold); color: var(--gold); padding: 6px 16px; border-radius: 3px; font-family: 'Barlow Condensed', sans-serif; font-size: .9rem; font-weight: 600; letter-spacing: 1px; }
    .values-list { list-style: none; display: flex; flex-direction: column; gap: .9rem; }
    .values-list li { display: flex; align-items: flex-start; gap: 12px; font-size: .95rem; color: #3a4a5e; line-height: 1.5; }
    .values-list li::before { content: '▶'; color: var(--accent); font-size: .65rem; margin-top: 5px; flex-shrink: 0; }

/* SERVICES */
#services { background: var(--light); }
    .services-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; }
    .svc-card { background: var(--white); border-top: 4px solid var(--accent); border-radius: 4px; padding: 2rem 1.6rem; transition: transform .2s, box-shadow .2s; }
    .svc-card:hover { transform: translateY(-6px); box-shadow: 0 16px 40px rgba(11,31,58,.12); }
    .svc-card-header { display: flex; align-items: center; gap: 1rem; margin-bottom: 1rem; }
    .svc-icon { width: 52px; height: 52px; min-width: 52px; background: linear-gradient(135deg, var(--navy), var(--steel)); border-radius: 8px; display: flex; align-items: center; justify-content: center; font-size: 1.4rem; }
    .svc-card h3 { font-family: 'Barlow Condensed', sans-serif; font-size: 1.2rem; font-weight: 700; margin-bottom: 0; color: var(--navy); text-transform: uppercase; letter-spacing: .5px; }
    .svc-card p { font-size: .88rem; color: var(--gray); line-height: 1.65; }
    .svc-tags { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 1rem; }
    .svc-tag { background: var(--light); color: var(--navy); font-size: .72rem; font-weight: 600; padding: 3px 10px; border-radius: 20px; border: 1px solid var(--border); }

/* CLIENTS */
#clients { background: var(--navy); }
#clients .section-title { color: var(--white); }
#clients .section-tag { background: rgba(255,255,255,.08); color: #b0c4de; }
    .client-category { margin-bottom: 3.5rem; }
    .cat-title { font-family: 'Barlow Condensed', sans-serif; font-size: .75rem; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; color: var(--accent); margin-bottom: 1.2rem; display: flex; align-items: center; gap: 12px; }
    .cat-title::after { content: ''; flex: 1; height: 1px; background: rgba(255,255,255,.12); }
    .clients-row { display: flex; flex-wrap: wrap; gap: .8rem; }
    .client-pill { background: rgba(255,255,255,.07); border: 1px solid rgba(255,255,255,.12); color: #c5d6ea; padding: 10px 20px; border-radius: 3px; font-size: .88rem; font-weight: 500; transition: background .2s, border-color .2s; }
    .client-pill:hover { background: rgba(224,91,20,.2); border-color: var(--accent); color: #fff; }

/* MACHINES */
#machines { background: var(--white); }
    .machine-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.8rem; }
    .machine-card { border: 1px solid var(--border); border-radius: 6px; overflow: hidden; transition: transform .25s, box-shadow .25s; background: var(--white); }
    .machine-card:hover { transform: translateY(-6px); box-shadow: 0 16px 40px rgba(11,31,58,.13); }
    .machine-img { height: 200px; overflow: hidden; position: relative; }
    .machine-img img { width: 100%; height: 100%; object-fit: cover; transition: transform .4s; display: block; }
    .machine-card:hover .machine-img img { transform: scale(1.06); }
    .machine-img-overlay {
        position: absolute; bottom: 0; left: 0; right: 0;
        background: linear-gradient(to top, rgba(11,31,58,.85) 0%, transparent 100%);
        padding: 12px 14px 10px;
    }
    .machine-img-label {
        font-family: 'Barlow Condensed', sans-serif; font-size: .7rem; font-weight: 700;
        letter-spacing: 2px; text-transform: uppercase; color: var(--accent);
    }
    .machine-body { padding: 1.4rem 1.5rem; }
    .machine-body h3 { font-family: 'Barlow Condensed', sans-serif; font-size: 1.6rem; font-weight: 800; text-transform: uppercase; margin-bottom: .5rem; color: var(--navy); letter-spacing: .5px; }
    .machine-body p { font-size: .87rem; color: var(--gray); line-height: 1.65; margin-bottom: .8rem; }
    .machine-specs { display: flex; flex-wrap: wrap; gap: 6px; }
    .machine-spec { background: var(--light); color: var(--navy); font-size: .7rem; font-weight: 600; padding: 3px 9px; border-radius: 20px; border: 1px solid var(--border); }

/* TESTIMONIALS */
#testimonials { background: var(--light); }
    .testimonial-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; }
    .t-card { background: var(--white); border-radius: 4px; padding: 1.8rem 1.5rem; border-left: 4px solid var(--accent); transition: transform .2s, box-shadow .2s; }
    .t-card:hover { transform: translateY(-4px); box-shadow: 0 12px 30px rgba(11,31,58,.1); }
    .t-quote { font-size: .95rem; color: #3a4a5e; line-height: 1.7; margin-bottom: 1.2rem; font-style: italic; }
    .t-quote::before { content: '\201C'; font-size: 2rem; color: var(--accent); line-height: 0; vertical-align: -.4em; margin-right: 4px; }
    .t-author { display: flex; align-items: center; gap: 12px; }
    .t-avatar { width: 40px; height: 40px; border-radius: 50%; background: linear-gradient(135deg, var(--navy), var(--steel)); display: flex; align-items: center; justify-content: center; color: #fff; font-weight: 700; font-size: .9rem; font-family: 'Barlow Condensed', sans-serif; flex-shrink: 0; }
    .t-name { font-weight: 700; font-size: .88rem; color: var(--navy); }
    .t-company { font-size: .78rem; color: var(--gray); margin-top: 1px; }
    .stars { color: var(--gold); font-size: .75rem; margin-bottom: .5rem; }

/* CONTACT */
#contact { background: var(--navy); }
#contact .section-title { color: var(--white); }
#contact .section-tag { background: rgba(255,255,255,.08); color: #b0c4de; }
#contact .section-desc { color: #7898b5; }
    .contact-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: start; }
    .contact-info { display: flex; flex-direction: column; gap: 1.5rem; }
    .info-item { display: flex; gap: 1rem; align-items: flex-start; }
    .info-icon { width: 44px; height: 44px; flex-shrink: 0; background: rgba(224,91,20,.15); border: 1px solid rgba(224,91,20,.3); border-radius: 4px; display: flex; align-items: center; justify-content: center; font-size: 1.2rem; }
    .info-label { font-size: .72rem; text-transform: uppercase; letter-spacing: 1px; color: #7898b5; margin-bottom: 3px; }
    .info-value { color: #c5d6ea; font-size: .95rem; line-height: 1.5; }
    .info-value a { color: var(--accent); text-decoration: none; }
    .contact-form { display: flex; flex-direction: column; gap: 1rem; }
    .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
    .form-group { display: flex; flex-direction: column; gap: 6px; }
    .form-group label { font-size: .78rem; text-transform: uppercase; letter-spacing: .8px; color: #7898b5; }
    .form-group input, .form-group textarea, .form-group select { background: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.12); border-radius: 3px; padding: 11px 14px; color: var(--white); font-size: .9rem; font-family: 'Barlow', sans-serif; outline: none; transition: border-color .2s; }
    .form-group input::placeholder, .form-group textarea::placeholder { color: #4a607a; }
    .form-group input:focus, .form-group textarea:focus, .form-group select:focus { border-color: var(--accent); }
    .form-group textarea { resize: vertical; min-height: 100px; }
    .form-group select option { background: var(--navy); }
    .form-submit { background: var(--accent); color: #fff; border: none; padding: 13px 32px; border-radius: 3px; font-size: .95rem; font-weight: 600; letter-spacing: .5px; cursor: pointer; transition: background .2s; align-self: flex-start; font-family: 'Barlow', sans-serif; }
    .form-submit:hover { background: #c04e10; }
    .form-success { display: none; background: rgba(30,180,100,.15); border: 1px solid rgba(30,180,100,.3); color: #4fd494; padding: 12px 16px; border-radius: 3px; font-size: .9rem; }

/* FOOTER */
footer { background: #060f1e; padding: 2.5rem 8%; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem; }
    .footer-logo { font-family: 'Barlow Condensed', sans-serif; font-weight: 800; font-size: 1.2rem; color: var(--white); }
    .footer-logo span { color: var(--accent); }
    .footer-copy { font-size: .78rem; color: #4a607a; }
    .footer-links { display: flex; gap: 1.5rem; }
    .footer-links a { font-size: .78rem; color: #4a607a; text-decoration: none; transition: color .2s; }
    .footer-links a:hover { color: var(--accent); }

/* MAP SECTION */
#location { background: var(--light); padding: 90px 8% 0; }
#location .section-desc { margin-bottom: 2rem; }
.map-wrapper {
    border-radius: 8px; overflow: hidden;
    box-shadow: 0 8px 32px rgba(11,31,58,.15);
    border: 3px solid var(--accent);
    margin-bottom: 2rem;
}

.map-wrapper iframe { display: block; width: 100%; height: 420px; border: none; }
.map-actions { display: flex; gap: 1rem; flex-wrap: wrap; margin-bottom: 60px; }
.map-btn {
    display: inline-flex; align-items: center; gap: 8px;
    background: var(--accent); color: #fff;
    padding: 12px 24px; border-radius: 4px;
    font-weight: 600; font-size: .9rem; text-decoration: none;
    transition: background .2s, transform .15s;
}

.map-btn:hover { background: #c04e10; transform: translateY(-2px); }
.map-btn.outline {
    background: transparent; color: var(--navy);
    border: 2px solid var(--navy);
}
.map-btn.outline:hover { background: var(--navy); color: #fff; }

/* TABLET (768px - 900px) */
@media (max-width: 900px) {
    nav { padding: 0 3%; }
    .nav-logo svg { height: 42px; }
    section { padding: 70px 5%; }
    #home { padding: 100px 5% 60px; }
    
    .services-grid, .machine-grid, .testimonial-grid { grid-template-columns: 1fr 1fr; }
    .about-grid, .contact-grid { grid-template-columns: 1fr; gap: 3rem; }
    .about-visual { padding: 2.5rem 2rem; }
    
    .hero-title { font-size: clamp(2.5rem, 5vw, 4rem); }
    .hero-stats { position: static; margin-top: 2.5rem; gap: 1.5rem; display: grid; grid-template-columns: repeat(3, 1fr); }
    .stat-num { font-size: 2.2rem; }
    
    .section-title { font-size: clamp(1.6rem, 3vw, 2.4rem); }
    .hero-sub { font-size: clamp(.9rem, 1.2vw, 1rem); }
    
    .machine-grid { gap: 1.4rem; }
    .machine-img { height: 180px; }
    .machine-body h3 { font-size: 1.3rem; }
    
    .form-row { grid-template-columns: 1fr; }
    .clients-row { gap: 0.6rem; }
    .client-pill { padding: 8px 16px; font-size: .82rem; }
}

/* SMALL TABLET / LANDSCAPE MOBILE (600px - 768px) */
@media (max-width: 768px) {
    nav { padding: 0 4%; height: 64px; }
    .nav-logo svg { height: 40px; }
    .nav-links { display: none; }
    .nav-hamburger { display: flex; }
    
    section { padding: 60px 4%; }
    #home { padding: 90px 4% 50px; min-height: 600px; }
    
    .hero-title { font-size: clamp(2rem, 5vw, 3.5rem); }
    .hero-sub { font-size: clamp(.85rem, 1.1vw, .95rem); max-width: 100%; }
    .hero-btns { gap: 0.75rem; }
    .hero-tag { padding: 3px 12px; font-size: .7rem; }
    
    .hero-stats { grid-template-columns: repeat(3, 1fr); gap: 1rem; margin-top: 2rem; }
    .stat-num { font-size: 2rem; }
    .stat-label { font-size: .7rem; }
    
    .section-title { font-size: clamp(1.4rem, 2.8vw, 2rem); }
    .section-desc { font-size: .95rem; }
    
    .about-grid { grid-template-columns: 1fr; }
    .about-visual h3 { font-size: 1.5rem; margin-bottom: 0.8rem; }
    .about-visual { padding: 2rem 1.5rem; }
    
    .services-grid { grid-template-columns: 1fr; gap: 1.2rem; }
    .svc-card { padding: 1.5rem 1.3rem; }
    .svc-card-header { margin-bottom: 0.8rem; }
    .svc-icon { width: 48px; height: 48px; font-size: 1.2rem; }
    .svc-card h3 { font-size: 1rem; }
    .svc-card p { font-size: .85rem; }
    
    .machine-grid { grid-template-columns: 1fr; gap: 1rem; }
    .machine-img { height: 200px; }
    .machine-card { border-radius: 4px; }
    .machine-body { padding: 1.2rem 1.3rem; }
    .machine-body h3 { font-size: 1.2rem; margin-bottom: 0.6rem; }
    .machine-body p { font-size: .82rem; margin-bottom: .6rem; }
    
    .testimonial-grid { grid-template-columns: 1fr; gap: 1.2rem; }
    .t-card { padding: 1.5rem 1.3rem; border-left-width: 3px; }
    .t-quote { font-size: .9rem; margin-bottom: 1rem; }
    .t-author { gap: 10px; }
    .t-avatar { width: 36px; height: 36px; font-size: .8rem; }
    .t-name { font-size: .82rem; }
    
    .clients-row { gap: 0.5rem; }
    .client-pill { padding: 7px 14px; font-size: .75rem; border-radius: 2px; }
    
    .contact-grid { grid-template-columns: 1fr; gap: 2rem; }
    .form-row { grid-template-columns: 1fr; gap: 0.8rem; }
    .form-group label { font-size: .75rem; }
    .form-group input, .form-group textarea { padding: 10px 12px; font-size: .9rem; }
    
    .map-wrapper iframe { height: 300px; }
    .map-actions { flex-direction: column; gap: 0.8rem; }
    .map-btn { width: 100%; justify-content: center; padding: 11px 20px; font-size: .85rem; }
    
    #contact .section-title { font-size: clamp(1.3rem, 2.5vw, 1.8rem); }
    
    footer { flex-direction: column; text-align: center; gap: 0.8rem; padding: 2rem 4%; }
    .footer-links { justify-content: center; gap: 1rem; }
    .footer-logo { font-size: 1rem; }
    .footer-copy { font-size: .7rem; }
}

/* MOBILE (max 600px) */
@media (max-width: 600px) {
    html { font-size: 15px; }
    
    nav { padding: 0 3%; height: 60px; }
    .nav-logo svg { height: 36px; }
    .nav-links { display: none; }
    .nav-hamburger { display: flex; min-width: 40px; min-height: 40px; }
    .nav-hamburger span { width: 22px; height: 2px; }
    
    section { padding: 50px 3%; }
    #home { padding: 80px 3% 40px; min-height: 600px; }
    
    .scroll-line { display: none; }
    
    .hero-tag { display: inline-block; padding: 3px 10px; font-size: .65rem; letter-spacing: 1.5px; }
    .hero-title { font-size: clamp(1.8rem, 5vw, 2.8rem); margin-bottom: 0.8rem; line-height: 1.2; }
    .hero-sub { font-size: clamp(.8rem, 1vw, .9rem); margin-bottom: 1.5rem; line-height: 1.6; max-width: 100%; }
    
    .hero-btns { flex-direction: column; gap: 0.6rem; }
    .hero-btns a, .hero-btns button { width: 100%; text-align: center; padding: 12px 16px; font-size: .9rem; }
    .btn-primary { font-size: .9rem; padding: 12px 16px; }
    .btn-outline { font-size: .9rem; padding: 11px 16px; border-width: 2px; }
    
    .hero-stats { grid-template-columns: repeat(3, 1fr); gap: 0.8rem; margin-top: 1.5rem; }
    .stat-num { font-size: 1.6rem; }
    .stat-label { font-size: .65rem; letter-spacing: .8px; margin-top: 2px; }
    
    .section-tag { padding: 3px 10px; font-size: .65rem; letter-spacing: 1.5px; margin-bottom: .6rem; }
    .section-title { font-size: clamp(1.3rem, 2.5vw, 1.8rem); margin-bottom: 0.4rem; letter-spacing: .3px; }
    .section-desc { font-size: .88rem; margin-bottom: 2rem; }
    
    .about-grid { grid-template-columns: 1fr; gap: 1.5rem; }
    .about-visual { padding: 1.5rem 1.2rem; border-radius: 3px; }
    .about-visual::after { font-size: 80px; right: -15px; bottom: -15px; }
    .about-visual h3 { font-size: 1.2rem; font-weight: 700; margin-bottom: 0.6rem; }
    .about-visual p { font-size: .82rem; line-height: 1.6; }
    .gstin-badge { padding: 5px 12px; font-size: .75rem; margin-top: 1rem; }
    .values-list { gap: 0.7rem; }
    .values-list li { font-size: .82rem; gap: 10px; }
    
    .services-grid { grid-template-columns: 1fr; gap: 1rem; }
    .svc-card { padding: 1.3rem 1rem; border-top-width: 3px; }
    .svc-card-header { gap: 0.8rem; margin-bottom: 0.7rem; }
    .svc-icon { width: 44px; height: 44px; min-width: 44px; font-size: 1.1rem; }
    .svc-card h3 { font-size: .95rem; }
    .svc-card p { font-size: .82rem; line-height: 1.6; }
    .svc-tags { gap: 5px; margin-top: 0.8rem; }
    .svc-tag { font-size: .65rem; padding: 2px 8px; }
    
    .machine-grid { grid-template-columns: 1fr; gap: 0.8rem; }
    .machine-img { height: 180px; }
    .machine-card { border-radius: 3px; border-width: 1px; }
    .machine-body { padding: 1rem 1.2rem; }
    .machine-body h3 { font-size: 1.1rem; text-transform: uppercase; margin-bottom: 0.5rem; }
    .machine-body p { font-size: .8rem; margin-bottom: 0.6rem; }
    .machine-specs { gap: 5px; }
    .machine-spec { font-size: .65rem; padding: 2px 7px; }
    .machine-img-label { font-size: .65rem; }
    
    .testimonial-grid { grid-template-columns: 1fr; gap: 1rem; }
    .t-card { padding: 1.2rem 1rem; border-left-width: 3px; border-radius: 2px; }
    .t-quote { font-size: .82rem; margin-bottom: 0.8rem; line-height: 1.6; }
    .t-author { gap: 8px; }
    .t-avatar { width: 32px; height: 32px; font-size: .7rem; }
    .t-name { font-size: .75rem; }
    .t-company { font-size: .7rem; }
    .stars { font-size: .65rem; margin-bottom: 0.4rem; }
    
    #clients .section-title { color: #fff; font-size: clamp(1.2rem, 2.3vw, 1.6rem); }
    #clients .section-tag { background: rgba(255,255,255,.06); color: #9db4ca; }
    .client-category { margin-bottom: 2rem; }
    .cat-title { font-size: .65rem; letter-spacing: 1.5px; margin-bottom: 0.8rem; }
    .clients-row { gap: 0.4rem; }
    .client-pill { padding: 6px 12px; font-size: .7rem; border-radius: 2px; min-height: 32px; display: flex; align-items: center; }
    
    .contact-grid { grid-template-columns: 1fr; gap: 1.5rem; }
    .contact-info { gap: 1.2rem; }
    .info-item { gap: 0.8rem; }
    .info-icon { width: 40px; height: 40px; min-width: 40px; font-size: 1rem; }
    .info-label { font-size: .65rem; margin-bottom: 2px; }
    .info-value { font-size: .82rem; }
    
    .form-group { gap: 5px; margin-bottom: 0.8rem; }
    .form-group label { font-size: .7rem; letter-spacing: .6px; }
    .form-group input, .form-group textarea, .form-group select {
        padding: 10px 11px;
        font-size: 16px !important;
        border-radius: 2px;
        border-width: 1px;
    }
    .form-group textarea { min-height: 90px; }
    .form-submit { padding: 11px 24px; font-size: .85rem; letter-spacing: .3px; }
    .form-success { padding: 10px 12px; font-size: .8rem; }
    
    .field-error, .field-ok { font-size: .65rem; margin-top: 3px; }
    .form-group .field-icon { top: 36px; font-size: .8rem; }
    
    .company-dropdown { max-height: 150px; }
    .company-option { padding: 9px 12px; font-size: .8rem; }
    
    .map-wrapper { border-width: 2px; margin-bottom: 1.5rem; }
    .map-wrapper iframe { height: 250px; }
    .map-actions { flex-direction: column; gap: 0.6rem; margin-bottom: 40px; }
    .map-btn { width: 100%; padding: 10px 16px; font-size: .8rem; border-radius: 2px; }
    .map-btn svg, .map-btn span { font-size: .85rem; }
    
    #location .section-title { font-size: clamp(1.2rem, 2.3vw, 1.6rem); }
    #contact .section-title { font-size: clamp(1.2rem, 2.3vw, 1.6rem); }
    #contact .section-tag { background: rgba(255,255,255,.06); color: #9db4ca; }
    
    footer { padding: 1.5rem 3%; gap: 0.6rem; }
    .footer-logo { font-size: .95rem; }
    .footer-logo span { color: var(--accent); }
    .footer-copy { font-size: .65rem; }
    .footer-links { gap: 0.8rem; flex-wrap: wrap; }
    .footer-links a { font-size: .68rem; }
    
    .mobile-menu { top: 60px; }
    .mobile-menu.open { max-height: 80vh; }
    .mobile-menu ul li a {
        padding: 14px 4%;
        font-size: .9rem;
        min-height: 44px;
        display: flex;
        align-items: center;
    }
}

/* SMALL MOBILE (max 480px) */
@media (max-width: 480px) {
    html { font-size: 14px; }
    
    nav { padding: 0 2.5%; height: 56px; }
    .nav-logo svg { height: 32px; }
    .nav-hamburger { min-width: 36px; min-height: 36px; gap: 4px; }
    .nav-hamburger span { width: 20px; height: 1.8px; }
    
    section { padding: 40px 2.5%; }
    #home { padding: 70px 2.5% 30px; min-height: 550px; }
    
    .hero-title { font-size: clamp(1.5rem, 4vw, 2.2rem); margin-bottom: 0.6rem; }
    .hero-sub { font-size: clamp(.75rem, .9vw, .8rem); margin-bottom: 1.2rem; }
    .hero-tag { padding: 2px 8px; font-size: .6rem; letter-spacing: 1px; }
    
    .hero-btns { gap: 0.5rem; }
    .hero-btns a { padding: 10px 14px; font-size: .8rem; }
    
    .hero-stats { gap: 0.6rem; margin-top: 1.2rem; }
    .stat-num { font-size: 1.4rem; }
    .stat-label { font-size: .6rem; letter-spacing: .5px; }
    
    .section-title { font-size: clamp(1.1rem, 2vw, 1.5rem); }
    .section-desc { font-size: .82rem; margin-bottom: 1.5rem; }
    .section-tag { padding: 2px 8px; font-size: .6rem; margin-bottom: .5rem; }
    
    .about-visual { padding: 1.2rem 1rem; }
    .about-visual h3 { font-size: 1rem; margin-bottom: 0.5rem; }
    .about-visual p { font-size: .75rem; }
    
    .svc-card { padding: 1rem 0.9rem; }
    .svc-icon { width: 40px; height: 40px; font-size: 1rem; }
    .svc-card h3 { font-size: .85rem; }
    .svc-card p { font-size: .75rem; }
    
    .machine-img { height: 160px; }
    .machine-body h3 { font-size: .95rem; }
    .machine-body p { font-size: .75rem; }
    
    .t-quote { font-size: .75rem; }
    .t-avatar { width: 28px; height: 28px; font-size: .6rem; }
    
    .client-pill { padding: 5px 10px; font-size: .65rem; }
    .cat-title { font-size: .6rem; }
    
    .form-group input, .form-group textarea { font-size: 16px !important; padding: 9px 10px; }
    .form-submit { padding: 9px 18px; font-size: .8rem; }
    
    .map-wrapper iframe { height: 220px; }
    .map-btn { padding: 9px 12px; font-size: .75rem; }
    
    footer { padding: 1.2rem 2.5%; }
}

/* FORM VALIDATION STYLES */
.form-group { position: relative; }
.form-group input.valid, .form-group textarea.valid, .form-group select.valid {
    border-color: #2ecc71 !important;
}

.form-group input.invalid, .form-group textarea.invalid, .form-group select.invalid {
    border-color: #e74c3c !important;
}

.field-error {
    display: none;
    color: #e74c3c;
    font-size: .72rem;
    margin-top: 4px;
    letter-spacing: .3px;
}
.field-error.show { display: block; }
.field-ok {
    display: none;
    color: #2ecc71;
    font-size: .72rem;
    margin-top: 4px;
}
.field-ok.show { display: block; }
.form-group .field-icon {
    position: absolute;
    right: 12px;
    top: 38px;
    font-size: .9rem;
    pointer-events: none;
}

/* COMPANY AUTOCOMPLETE */
.company-wrap { position: relative; }
.company-dropdown {
    display: none;
    position: absolute;
    top: calc(100% + 4px);
    left: 0; right: 0;
    background: #0f2944;
    border: 1px solid rgba(224,91,20,.5);
    border-radius: 4px;
    z-index: 300;
    max-height: 200px;
    overflow-y: auto;
    box-shadow: 0 8px 24px rgba(0,0,0,.4);
}

.company-dropdown.show { display: block; }
.company-option {
    padding: 10px 14px;
    color: #c5d6ea;
    font-size: .88rem;
    cursor: pointer;
    border-bottom: 1px solid rgba(255,255,255,.06);
    transition: background .15s;
}

.company-option:last-child { border-bottom: none; }
.company-option:hover, .company-option.highlighted { background: rgba(224,91,20,.2); color: #fff; }
.company-option mark { background: none; color: var(--accent); font-weight: 700; }

/* HAMBURGER BUTTON */
.nav-hamburger {
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    cursor: pointer;
    padding: 10px;
    background: none;
    border: none;
    z-index: 200;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
    min-width: 44px;
    min-height: 44px;
}

.nav-hamburger span {
    display: block;
    width: 26px;
    height: 2px;
    background: #b0c4de;
    border-radius: 2px;
    transition: all .3s ease;
    pointer-events: none;
}

.nav-hamburger.open span:nth-child(1) { transform: translateY(7px) rotate(45deg); background: var(--accent); }
.nav-hamburger.open span:nth-child(2) { opacity: 0; }
.nav-hamburger.open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); background: var(--accent); }

/* MOBILE DROPDOWN MENU */
.mobile-menu {
    position: fixed;
    top: 68px;
    left: 0; right: 0;
    background: var(--navy);
    border-top: 2px solid var(--accent);
    z-index: 99;
    box-shadow: 0 8px 24px rgba(0,0,0,.5);
    padding: 0;
    overflow: hidden;
    max-height: 0;
    transition: max-height .35s ease;
    -webkit-overflow-scrolling: touch;
}

.mobile-menu.open { max-height: 600px; }
.mobile-menu ul { list-style: none; padding: 8px 0 12px; }
.mobile-menu ul li a {
    display: block;
    padding: 16px 6%;
    color: #b0c4de;
    text-decoration: none;
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: .8px;
    text-transform: uppercase;
    border-bottom: 1px solid rgba(255,255,255,.06);
    transition: color .2s, background .2s;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
    min-height: 44px;
}

.mobile-menu ul li:last-child a { border-bottom: none; }
.mobile-menu ul li a:hover,
.mobile-menu ul li a:active,
.mobile-menu ul li a.active { color: var(--accent); background: rgba(224,91,20,.08); }

/* iOS & CROSS-PLATFORM FIXES */
* { -webkit-tap-highlight-color: transparent; }
html { -webkit-text-size-adjust: 100%; }
input, textarea, select {
    -webkit-appearance: none;
    appearance: none;
    border-radius: 3px;
    font-size: 16px !important;
}

.btn-primary, .btn-outline, .form-submit, .map-btn {
    touch-action: manipulation;
    cursor: pointer;
}

a { touch-action: manipulation; }

@media (max-width: 600px) {
    nav { padding: 0 5%; }
    .nav-links { display: none; }
    .nav-hamburger { display: flex; }
    section { padding: 60px 5%; }
    #home { padding: 100px 5% 60px; }
    .services-grid, .machine-grid, .testimonial-grid { grid-template-columns: 1fr; }
    .hero-btns { flex-direction: column; }
    .hero-btns a, .hero-btns button { width: 100%; text-align: center; }
    .map-actions { flex-direction: column; }
    .map-btn { width: 100%; justify-content: center; }
    footer { flex-direction: column; text-align: center; }
    .footer-links { justify-content: center; flex-wrap: wrap; }
    .form-row { grid-template-columns: 1fr; }
}
